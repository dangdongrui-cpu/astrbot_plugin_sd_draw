{
  "backend_primary": { "type": "string", "default": "webui", "description": "主后端引擎（可选 webui / comfyui / openai）" },
  "webui_url": { "type": "string", "default": "http://127.0.0.1:7860", "description": "WebUI 地址（A1111 / Forge，需 --api 启动）" },
  "comfyui_url": { "type": "string", "default": "http://127.0.0.1:8188", "description": "ComfyUI 地址" },
  "openai_api_key": { "type": "string", "default": "", "description": "OpenAI 兼容 API 密钥（选 openai 后端时必填）" },
  "openai_base_url": { "type": "string", "default": "https://api.openai.com/v1", "description": "OpenAI 兼容基准地址" },
  "openai_model": { "type": "string", "default": "gpt-image-1", "description": "OpenAI 生图模型名" },
  "default_model": { "type": "string", "default": "", "description": "默认 checkpoint 文件名（本地引擎用）" },
  "width": { "type": "int", "default": 1024, "description": "生图宽度（像素）" },
  "height": { "type": "int", "default": 1216, "description": "生图高度（像素）" },
  "steps": { "type": "int", "default": 28, "description": "采样步数" },
  "cfg_scale": { "type": "float", "default": 6.0, "description": "CFG 引导强度" },
  "sampler": { "type": "string", "default": "DPM++ 2M Karras", "description": "采样器名称" },
  "negative_prompt": { "type": "text", "default": "lowres, bad anatomy, bad hands, blurry, worst quality", "description": "负面提示词" },
  "hires": { "type": "bool", "default": true, "description": "自动高清修复（hires fix）" },
  "hires_upscaler": { "type": "string", "default": "R-ESRGAN 4x+ Anime6B", "description": "高清放大器" },
  "quota_per_user_per_day": { "type": "int", "default": 1, "description": "每人每日额度" },
  "quota_total_per_day": { "type": "int", "default": 10, "description": "全群每日总额度" },
  "desc_max_len": { "type": "int", "default": 500, "description": "描述字数上限" },
  "confirm_timeout": { "type": "int", "default": 30, "description": "生成确认等待秒数" },
  "cancel_timeout": { "type": "int", "default": 120, "description": "操作会话过期秒数" },
  "pollish_on": { "type": "bool", "default": true, "description": "润色总开关（中文润色+翻译+微调控件）" },
  "pollish_model": { "type": "string", "default": "", "description": "润色/翻译/微调模型名（留空用默认）" },
  "allow_private": { "type": "bool", "default": false, "description": "允许私聊使用" },
  "nsfw_on": { "type": "bool", "default": false, "description": "NSFW 许可总闸（默认关；仅作用于群聊链路，API 直连不受限）" },
  "nsfw_whitelist": { "type": "list", "items": { "type": "string" }, "default": [], "description": "NSFW 白名单群号（逗号分隔）" },
  "download_dir": { "type": "string", "default": "", "description": "模型下载目录（留空=插件 data/downloads）" },
  "download_source": { "type": "string", "default": "hf-mirror", "description": "下载源（可选 official / hf-mirror / hf-mirror2 / custom）" },
  "engine_dir": { "type": "string", "default": "", "description": "引擎部署目录（留空=插件 data/engines）" },
  "admin_port": { "type": "int", "default": 7865, "description": "管理页端口（重启后生效）" }
}